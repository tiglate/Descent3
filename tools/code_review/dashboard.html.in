<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Descent 3 · Source review progress</title>
<style>
:root{color-scheme:light dark;--bg:#f4f6fa;--surface:#fff;--text:#172538;--muted:#526279;--line:#d3dbe5;--accent:#126e65;--track:#e6ebf1;--done:#168270;--work:#2e70ba;--dismiss:#797785;--p1:#b34230;--p2:#8b6517;--p3:#4d6795}
@media(prefers-color-scheme:dark){:root{--bg:#121b28;--surface:#1c293a;--text:#ecf1f8;--muted:#b0bfd0;--line:#3b4b60;--accent:#6ad6c2;--track:#344153;--done:#58c9ad;--work:#75aaf4;--dismiss:#b0adbe;--p1:#ff9a87;--p2:#e4c478;--p3:#acc5ef}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 system-ui,sans-serif}main{max-width:1440px;margin:auto;padding:32px}header{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;align-items:center}h1{font-size:30px;line-height:1.15;margin:8px 0}h2{font-size:18px;margin:0 0 18px}h3{font-size:16px;margin:12px 0 5px}p{margin:8px 0}.eyebrow{letter-spacing:.12em;text-transform:uppercase;font-size:12px;color:var(--accent);font-weight:700}.muted,small{color:var(--muted)}a{color:var(--accent)}button,select,input,textarea{font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:8px}button{cursor:pointer}button:hover{border-color:var(--accent)}button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--accent);outline-offset:2px}button.primary{background:var(--accent);color:var(--bg);border-color:var(--accent)}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:24px 0}.card,section.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:20px}.metric{font-size:30px;font-weight:650;font-variant-numeric:tabular-nums}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}.stack{display:flex;height:22px;overflow:hidden;border-radius:3px;background:var(--track);margin:12px 0}.stack span{transition:width .2s}.done{background:var(--done)}.working{background:var(--work)}.dismissed{background:var(--dismiss)}.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:13px}.legend span::before{content:"";display:inline-block;width:9px;height:9px;margin-right:5px;background:var(--track)}.legend .ld::before{background:var(--done)}.legend .lw::before{background:var(--work)}.legend .lx::before{background:var(--dismiss)}.bar-row{display:grid;grid-template-columns:155px 1fr 50px;gap:12px;align-items:center;margin:12px 0}.track{height:13px;background:var(--track);border-radius:2px;overflow:hidden}.fill{height:100%;background:var(--accent);transition:width .2s}.number{text-align:right;font-variant-numeric:tabular-nums}.roadmap{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.phase{border-top:3px solid var(--line);padding-top:10px}.phase strong{font-size:22px;color:var(--accent)}.phase p{font-size:13px}.phase progress{width:100%;accent-color:var(--accent)}.filters{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:18px}.filters label{display:grid;gap:4px;font-size:13px}.filters input{min-width:220px}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;text-align:left;font-size:14px}th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}th,td{padding:12px 10px;vertical-align:top;border-bottom:1px solid var(--line)}td:first-child,th:first-child{padding-left:0}.title{min-width:290px;max-width:480px}.badge{font-size:12px;white-space:nowrap}.p1{color:var(--p1)}.p2{color:var(--p2)}.p3{color:var(--p3)}td select{width:140px}td input{width:125px}td textarea{width:220px;min-height:84px;resize:vertical}.detail{font-size:13px;margin-top:10px}.detail p{margin:8px 0}summary{cursor:pointer;color:var(--accent)}.history{max-height:260px;overflow:auto;padding-left:20px}.history li{margin:10px 0}.notice{padding:12px 0;color:var(--muted);font-size:13px}#message{min-height:24px;color:var(--accent)}#message.error{color:var(--p1)}.checks .bar-row{grid-template-columns:minmax(200px,1fr) 1fr 40px;font-size:12px;overflow-wrap:anywhere}.help{max-width:950px}footer{padding:20px 0;font-size:13px;color:var(--muted)}[hidden]{display:none!important}@media(max-width:850px){main{padding:20px}.summary{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.roadmap{grid-template-columns:1fr 1fr}.title{min-width:240px}}@media(max-width:480px){main{padding:14px}h1{font-size:25px}.card,section.panel{padding:15px}.bar-row{grid-template-columns:125px 1fr 40px;gap:6px}.checks .bar-row{grid-template-columns:1fr 75px 28px}.roadmap{grid-template-columns:1fr}.filters label,.filters input{width:100%}.actions button{min-height:44px}.summary{gap:8px}.metric{font-size:26px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}@media print{.actions,.filters,td select,td input,td textarea{display:none}body{background:white;color:black}.table-wrap{overflow:visible}.grid{display:block}.panel{break-inside:avoid}}
</style>
</head>
<body><main>
<header><div><div class="eyebrow">Descent 3 / engineering review</div><h1>Implementation progress</h1><p class="muted" id="baseline"></p></div><div class="actions"><a href="PLAN.md">Markdown plan</a><button id="export" class="primary">Export progress</button><button id="import">Import progress</button><input id="import-file" type="file" accept="application/json,.json" hidden></div></header>
<p class="notice help">Update owners, status and evidence below. Browser storage is a convenience; export JSON to save or share progress. Replace progress.json with the export and regenerate to update repository artifacts. Review completion is separate from implementation.</p>
<p id="message" role="status" aria-live="polite"></p>
<noscript>This tracker requires JavaScript. The complete findings and acceptance criteria are available in PLAN.md.</noscript>
<div class="summary" aria-live="polite"><div class="card"><div class="muted">Implemented</div><div class="metric" id="implemented"></div><small>Done with validation evidence</small></div><div class="card"><div class="muted">Unresolved</div><div class="metric" id="unresolved"></div><small id="active"></small></div><div class="card"><div class="muted">P1 unresolved</div><div class="metric" id="priority"></div><small>Resource ownership and bounds</small></div><div class="card"><div class="muted">Analyzed source files</div><div class="metric" id="coverage"></div><small>Linux Debug sample · fixed baseline</small></div></div>
<div class="grid"><section class="panel"><h2>Resolution by status</h2><div id="status-chart" class="stack" role="img"></div><div class="legend"><span class="ld">Done</span><span class="lw">In progress / Review</span><span class="lx">Dismissed</span><span>Backlog / Blocked</span></div><p id="status-counts" class="muted"></p><p class="notice">Dismissed items are resolved with a reason, and do not count as implemented. Charts count items equally.</p></section><section class="panel"><h2>Implementation by workstream</h2><div id="category-chart"></div></section></div>
<section class="panel" style="margin-bottom:16px"><h2>Implementation roadmap</h2><div class="roadmap" id="roadmap"></div><p class="notice">Phases express preferred order, not dates. Baseline triage and safety repairs may proceed together. Done requires all listed dependencies to be Done.</p></section>
<div class="grid"><section class="panel"><h2>Unresolved priority distribution</h2><div id="priority-chart"></div></section><section class="panel checks"><h2>Largest diagnostic groups · baseline</h2><div id="check-chart"></div><p class="notice" id="diagnostic-note"></p></section></div>
<section class="panel"><h2>Implementation register</h2><div class="filters"><label>Find an item<input id="search" type="search" placeholder="ID, title, owner or source"></label><label>Category<select id="category"><option value="">All categories</option></select></label><label>Status<select id="status"><option value="">All statuses</option></select></label></div><p id="row-count" class="muted"></p><div class="table-wrap"><table><caption style="text-align:left;padding-bottom:12px" class="muted">Expand a finding for evidence, proposed change and acceptance criteria. Notes must contain validation evidence for Done or a reason for Dismissed.</caption><thead><tr><th scope="col">Finding / evidence</th><th scope="col">Priority / phase</th><th scope="col">Status</th><th scope="col">Owner</th><th scope="col">Validation / PR / disposition</th></tr></thead><tbody id="rows"></tbody></table></div></section>
<div class="grid" style="margin-top:16px"><section class="panel"><h2>Recorded changes</h2><p class="muted" id="history-empty">No implementation updates yet.</p><ol class="history" id="history" reversed></ol></section><section class="panel"><h2>Recorded completion snapshots</h2><div id="snapshots"></div><p class="notice">Only actual recorded dates are shown. This is not a forecast or an inferred burndown.</p></section></div>
<footer id="footer"></footer>
</main>
<script id="review-data" type="application/json">__REVIEW_DATA__</script>
<script>
'use strict';
const base=JSON.parse(document.getElementById('review-data').textContent);
let data=structuredClone(base);
const statuses=['Backlog','In progress','Blocked','Review','Done','Dismissed'];
const categories=[...new Set(base.items.map(i=>i.category))];
const phases=['Baseline and triage','Resource and parser safety','Runtime policy and correctness','Cleanup and modernization','Coverage and verification'];
const key='descent3-code-review-v1-'+base.scan.commit;
const $=id=>document.getElementById(id);
function message(text,error=false){$('message').textContent=text;$('message').classList.toggle('error',error)}
function el(tag,text,cls){const node=document.createElement(tag);if(text!==undefined)node.textContent=text;if(cls)node.className=cls;return node}
function merge(saved){
 if(saved.schema_version!==1||saved.scan?.commit!==base.scan.commit||!Array.isArray(saved.items)||saved.items.length!==base.items.length)throw Error('The file belongs to a different review or schema.');
 const next=structuredClone(base), seen=new Set();
 for(const row of saved.items){const target=next.items.find(i=>i.id===row.id);if(!target||seen.has(row.id)||!statuses.includes(row.status))throw Error('Unknown ID, duplicate ID or invalid status.');seen.add(row.id);
  for(const k of ['owner','notes','updated'])if(typeof row[k]!=='string')throw Error('Invalid progress fields.');
  if(row.owner.length>300||row.notes.length>20000)throw Error('Progress field is too long.');
  Object.assign(target,{status:row.status,owner:row.owner,notes:row.notes,updated:row.updated});
 }
 for(const row of next.items){if(['Done','Dismissed'].includes(row.status)&&!row.notes.trim())throw Error(row.id+' requires evidence or a dismissal reason.');if(row.status==='Done'&&row.dependencies.some(id=>next.items.find(i=>i.id===id).status!=='Done'))throw Error(row.id+' has incomplete dependencies.');}
 if(!Array.isArray(saved.history)||!Array.isArray(saved.snapshots))throw Error('Missing history or snapshots.');
 if(saved.history.some(h=>!h||!['date','id','field','from','to'].every(k=>typeof h[k]==='string')))throw Error('Invalid history.');
 if(saved.snapshots.some(s=>!s||typeof s.date!=='string'||!['done','dismissed','total'].every(k=>Number.isInteger(s[k])&&s[k]>=0)||s.total!==next.items.length||s.done+s.dismissed>s.total))throw Error('Invalid completion snapshots.');
 next.history=saved.history;next.snapshots=saved.snapshots;return next;
}
function save(){try{localStorage.setItem(key,JSON.stringify(data));return true}catch{message('Browser storage is unavailable. Export progress now to keep your changes.',true);return false}}
try{const saved=localStorage.getItem(key);if(saved)data=merge(JSON.parse(saved));}catch{message('Saved browser data could not be loaded. Showing the repository baseline; import a valid export to restore it.',true)}
function resolved(i){return ['Done','Dismissed'].includes(i.status)}
function record(id,field,value){const item=data.items.find(i=>i.id===id),before=item[field];if(before===value)return;
 if(field==='status'&&['Done','Dismissed'].includes(value)&&!item.notes.trim()){message('Add validation evidence or a dismissal reason in Notes before closing '+id+'.',true);renderTable();return}
 if(field==='notes'&&!value.trim()&&resolved(item)){message('Closed items must retain validation evidence or a dismissal reason.',true);renderTable();return}
 if(field==='status'&&value==='Done'&&item.dependencies.some(dep=>data.items.find(i=>i.id===dep).status!=='Done')){message('Finish dependencies for '+id+': '+item.dependencies.join(', '),true);renderTable();return}
 if(field==='status'&&item.status==='Done'&&value!=='Done'&&data.items.some(i=>i.status==='Done'&&i.dependencies.includes(id))){message('Reopen dependent Done items before reopening '+id+'.',true);renderTable();return}
 item[field]=value;item.updated=new Date().toISOString();data.history.push({date:item.updated,id,field,from:before,to:value});
 const date=item.updated.slice(0,10),snapshot={date,done:data.items.filter(i=>i.status==='Done').length,dismissed:data.items.filter(i=>i.status==='Dismissed').length,total:data.items.length};
 const index=data.snapshots.findIndex(s=>s.date===date);if(index<0)data.snapshots.push(snapshot);else data.snapshots[index]=snapshot;
 if(save())message(id+' updated. Export progress to save a shareable copy.');renderCharts();if(field==='status')renderTable();
}
function bar(container,label,count,total,suffix,color){const row=el('div',undefined,'bar-row');row.append(el('span',label));const track=el('div',undefined,'track'),fill=el('div',undefined,'fill');fill.style.width=(total?count/total*100:0)+'%';if(color)fill.style.background=color;track.append(fill);track.setAttribute('role','img');track.setAttribute('aria-label',label+': '+suffix);row.append(track,el('span',suffix,'number'));container.append(row)}
function renderCharts(){
 const n=data.items.length,done=data.items.filter(i=>i.status==='Done').length,dismissed=data.items.filter(i=>i.status==='Dismissed').length,working=data.items.filter(i=>['In progress','Review'].includes(i.status)).length;
 $('implemented').textContent=done+' / '+n;$('unresolved').textContent=n-done-dismissed;$('active').textContent=working+' active · '+dismissed+' dismissed';$('priority').textContent=data.items.filter(i=>i.priority==='P1'&&!resolved(i)).length;$('coverage').textContent=base.scan.scanned_translation_units+' / '+base.scan.unique_translation_units;
 $('status-chart').replaceChildren();for(const [count,cls] of [[done,'done'],[working,'working'],[dismissed,'dismissed']]){const seg=el('span',undefined,cls);seg.style.width=(count/n*100)+'%';$('status-chart').append(seg)}
 $('status-chart').setAttribute('aria-label',done+' Done, '+working+' active, '+dismissed+' Dismissed, '+(n-done-working-dismissed)+' Backlog or Blocked');
 $('status-counts').textContent=statuses.map(s=>s+': '+data.items.filter(i=>i.status===s).length).join(' · ');
 $('category-chart').replaceChildren();for(const c of categories){const group=data.items.filter(i=>i.category===c),completed=group.filter(i=>i.status==='Done').length;bar($('category-chart'),c,completed,group.length,completed+'/'+group.length)}
 $('roadmap').replaceChildren();phases.forEach((name,p)=>{const group=data.items.filter(i=>i.phase===p),complete=group.filter(i=>i.status==='Done').length,phase=el('div',undefined,'phase');phase.append(el('strong',String(p)),el('h3',name),el('p',group.map(i=>i.id).join(' · ')));const progress=el('progress');progress.max=group.length;progress.value=complete;progress.setAttribute('aria-label',name+': '+complete+' of '+group.length+' implemented');phase.append(progress,el('p',complete+' / '+group.length+' implemented'));$('roadmap').append(phase)});
 $('priority-chart').replaceChildren();for(const p of ['P1','P2','P3']){const count=data.items.filter(i=>i.priority===p&&!resolved(i)).length;bar($('priority-chart'),p,count,n,String(count),'var(--'+p.toLowerCase()+')')}
 $('check-chart').replaceChildren();const checks=Object.entries(base.scan.diagnostic_counts).sort((a,b)=>b[1]-a[1]).slice(0,5);for(const [name,count] of checks)bar($('check-chart'),name,count,checks[0][1],String(count));$('diagnostic-note').textContent=base.scan.unique_diagnostics+' unique first-party diagnostics, including headers. Warnings require triage; these counts do not change when tasks are closed.';
 $('history').replaceChildren();$('history-empty').hidden=data.history.length>0;for(const h of [...data.history].reverse().slice(0,100)){const li=el('li');li.append(el('strong',h.id+' · '+h.field),el('div',h.date+' · '+(h.from||'(empty)')+' → '+(h.to||'(empty)')));$('history').append(li)}
 $('snapshots').replaceChildren();for(const s of [...data.snapshots].sort((a,b)=>a.date.localeCompare(b.date)))bar($('snapshots'),s.date,s.done,s.total,s.done+'/'+s.total);$('footer').textContent='Reviewed commit '+base.scan.commit+' · '+base.scan.tool+' · '+base.scan.configuration+'. No runtime sanitizer or cross-platform verification was performed in this baseline.';
}
function detailParagraph(container,label,text){const p=el('p');p.append(el('strong',label+' '),document.createTextNode(text));container.append(p)}
function renderTable(){const term=$('search').value.toLowerCase(),category=$('category').value,status=$('status').value;
 const filtered=data.items.filter(i=>(!category||i.category===category)&&(!status||i.status===status)&&[i.id,i.title,i.owner,...i.locations.map(l=>l.file)].join(' ').toLowerCase().includes(term));$('rows').replaceChildren();$('row-count').textContent=filtered.length+' of '+data.items.length+' items shown. Charts always show the full review.';
 for(const i of filtered){const row=el('tr');row.dataset.id=i.id;const title=el('td',undefined,'title');title.append(el('strong',i.id+' · '+i.title),el('div',i.category+' · '+i.size+' effort · '+i.confidence,'muted'));const details=el('details',undefined,'detail');details.append(el('summary','Evidence and acceptance'));
  for(const [name,value] of [['Evidence',i.evidence],['Proposed change',i.action],['Acceptance',i.validation],['Dependencies',i.dependencies.join(', ')||'None'],['Checks',i.checks.join(', ')||'Manual review']])detailParagraph(details,name,value);
  const sources=el('p');for(const loc of i.locations){const a=el('a',loc.file+':'+loc.line);a.href='../../'+loc.file;sources.append(a,document.createElement('br'))}details.append(sources);title.append(details);row.append(title);
  const priority=el('td');priority.append(el('strong',i.priority,'badge '+i.priority.toLowerCase()),el('div','Phase '+i.phase));row.append(priority);
  const st=el('select');st.setAttribute('aria-label',i.id+' status');for(const s of statuses){const option=el('option',s);option.value=s;st.append(option)}st.value=i.status;st.addEventListener('change',()=>record(i.id,'status',st.value));const statusCell=el('td');statusCell.append(st);row.append(statusCell);
  const owner=el('input');owner.value=i.owner;owner.maxLength=300;owner.placeholder='Unassigned';owner.setAttribute('aria-label',i.id+' owner');owner.addEventListener('change',()=>record(i.id,'owner',owner.value));const ownerCell=el('td');ownerCell.append(owner);row.append(ownerCell);
  const notes=el('textarea');notes.value=i.notes;notes.maxLength=20000;notes.placeholder='Test result, PR reference or dismissal reason';notes.setAttribute('aria-label',i.id+' notes');notes.addEventListener('change',()=>record(i.id,'notes',notes.value));const notesCell=el('td');notesCell.append(notes);row.append(notesCell);$('rows').append(row);
 }
}
for(const c of categories){const opt=el('option',c);opt.value=c;$('category').append(opt)}for(const s of statuses){const opt=el('option',s);opt.value=s;$('status').append(opt)}
for(const id of ['search','category','status'])$(id).addEventListener('input',renderTable);
$('export').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(data,null,2)+'\n'],{type:'application/json'}),url=URL.createObjectURL(blob),a=el('a');a.href=url;a.download='progress.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);message('Export created. Replace the repository progress.json and regenerate to publish these updates.');});
$('import').addEventListener('click',()=>$('import-file').click());$('import-file').addEventListener('change',async event=>{const file=event.target.files[0];if(!file)return;try{if(file.size>5_000_000)throw Error('File exceeds 5 MB.');const imported=merge(JSON.parse(await file.text()));data=imported;if(save())message('Progress imported. Finding definitions were preserved.');renderCharts();renderTable()}catch(error){message('Import rejected: '+error.message,true)}event.target.value='';});
$('baseline').textContent='Baseline '+base.scan.date+' · '+data.items.length+' planned items · source review + clang-tidy';renderCharts();renderTable();
</script></body></html>
